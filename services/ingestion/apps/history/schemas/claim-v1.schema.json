{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoryCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_id", "track", "statement", "claim_kind", "event_kind", "time", "value", "evidence_span_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "subject_id": {"type": "string", "minLength": 1},
    "track": {"enum": ["product", "customers", "pricing", "team", "marketing_distribution", "intellectual_property", "legal_regulatory", "operations_finance"]},
    "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
    "claim_kind": {"enum": ["documented_action", "source_reported_intent", "source_reported_outcome", "measurement", "source_attributed_claim"]},
    "event_kind": {"type": "string", "minLength": 1},
    "time": {"type": "object", "additionalProperties": false, "required": ["precision", "date_min", "date_max", "original_expression"]},
    "value": {"type": "object"},
    "evidence_span_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
